{
    "name": "korean",
    "version": "0.0.0",
    "license": "MIT",
    "private": true,
    "scripts": {
        "ng": "ng",
        "dev": "ng serve",
        "build": "ng build --base-href /korean/ && cp dist/korean/browser/index.html dist/korean/browser/404.html",
        "test": "ng test",
        "lint": "ng lint"
    },
    "prettier": {
        "tabWidth": 4,
        "singleQuote": true,
        "trailingComma": "all",
        "printWidth": 120,
        "arrowParens": "avoid",
        "bracketSpacing": false,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "dependencies": {
        "@angular/common": "^22.1.1",
        "@angular/compiler": "^22.1.1",
        "@angular/core": "^22.1.1",
        "@angular/forms": "^22.1.1",
        "@angular/platform-browser": "^22.1.1",
        "prettier": "^3.9.6",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular-eslint/builder": "22.1.0",
        "@angular/build": "^22.1.1",
        "@angular/cli": "^22.1.1",
        "@angular/compiler-cli": "^22.1.1",
        "@eslint/js": "^10.0.1",
        "angular-eslint": "22.1.0",
        "eslint": "^10.8.1",
        "jsdom": "^28.0.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "8.66.0",
        "vitest": "^4.1.11"
    }
}
